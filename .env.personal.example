# ============================================
# OPENMONETIS — Deploy pessoal (rede local)
# ============================================
# Copie para .env:  Copy-Item .env.personal.example .env
# Ou execute:      pnpm setup:personal
#
# Integrações externas (IA cloud, Resend, Umami, Logo.dev, Google OAuth)
# devem permanecer VAZIAS para manter dados financeiros na rede local.

# === Modo pessoal ===
PERSONAL_DEPLOYMENT=true
DISABLE_SIGNUP=true
DISABLE_UPDATE_CHECK=true

# === Database ===
POSTGRES_USER=openmonetis
POSTGRES_PASSWORD=CHANGE_ME_use_setup_script
POSTGRES_DB=openmonetis_db
DATABASE_URL=postgresql://openmonetis:CHANGE_ME_use_setup_script@localhost:5432/openmonetis_db

# === Better Auth ===
# Gere com: openssl rand -base64 32  (ou pnpm setup:personal)
BETTER_AUTH_SECRET=CHANGE_ME_use_setup_script
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=

# === Portas ===
APP_PORT=3000
DB_PORT=5432

# === MinIO local para anexos (opcional) ===
# Suba com: docker compose -f docker-compose.personal.yml --profile attachments up -d
# Funciona com pnpm dev (app no host) + MinIO no Docker.
MINIO_ROOT_USER=openmonetis_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_use_setup_script
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=openmonetis_minio
S3_SECRET_ACCESS_KEY=CHANGE_ME_use_setup_script
S3_BUCKET=openmonetis-attachments

# === Deixe vazio (não configurar em deploy pessoal) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
UMAMI_URL=
UMAMI_WEBSITE_ID=
UMAMI_DOMAINS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
LOGO_DEV_TOKEN=
LOGO_DEV_SECRET_KEY=
PUBLIC_DOMAIN=